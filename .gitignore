# Per-language build outputs
rust/target/
go/walker
go/walker.exe
cpp/build/
zig/zig-out/
zig/zig-cache/
zig/.zig-cache/

# Synthetic perf corpus (shared/generate_perf_corpus.py) -- large, regenerable, never commit
shared/corpus-perf/
# Dense beacon stress session lives in its own root (beacons-latest only) so it
# is not a straggler for the parallel full-fleet modes.
shared/corpus-perf-beacons/

# Coverage artifacts (shared/coverage.py)
/coverage/
cpp/build-cov/
go/walker-cov
go/covdata/
go/covdata-unit/
go/go-cov.txt
# Instrumented binaries write *.profraw to CWD when run without LLVM_PROFILE_FILE
*.profraw

# Editor / OS junk
*.swp
*.swo
.DS_Store
Thumbs.db

# Claude Code project-local state (settings.local.json, session-scoped logs, etc.)
.claude/

# Local git worktrees
.worktrees/

# Python bytecode
__pycache__/
*.pyc

# MCP server venv (created by install.sh / install.bat to host the `mcp` SDK)
mcp/.venv/

.maintenance.json

# aislop runtime artifacts (session log, caches) — keep only the config.
.aislop/*
!.aislop/config.yml
